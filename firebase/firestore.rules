rules_version = '2';

// Tumbuh keeps each parent's data (all their children) in one document: users/{uid}.
// Only the signed-in owner can read or change it. Nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['json', 'updated'])
          && d.json is string
          && d.json.size() < 900000
          && d.updated is int;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validData();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
