{
  "expo": {
    "name": "Tumbuh",
    "slug": "tumbuh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tumbuh",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tumbuh.baby",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F0EE",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "package": "app.tumbuh.baby"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Tumbuh",
      "shortName": "Tumbuh",
      "themeColor": "#FAFAF7",
      "backgroundColor": "#FAFAF7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/images/icon-foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
