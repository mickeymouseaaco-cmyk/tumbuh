{
  "expo": {
    "name": "Tumbuh",
    "slug": "tumbuh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tumbuh",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tumbuh.baby",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B26BD8",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "package": "app.tumbuh.baby"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Tumbuh",
      "shortName": "Tumbuh",
      "themeColor": "#0B0A1A",
      "backgroundColor": "#0B0A1A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A1A",
          "image": "./assets/images/icon-foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
